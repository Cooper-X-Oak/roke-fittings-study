  "story": {
    "mode": "semantic-assembly",
    "stages": [
      {
        "id": "intro",
        "range": [0, 0.14],
        "content": {
          "eyebrow": "CONCEPT VEHICLE / DIGITAL ASSEMBLY",
          "title": "一台车，先成为一个系统。",
          "body": "从结构基准、行走机构、功能核心、座舱到外部车身，这个概念样机用真实模型节点讲清产品构成。",
          "cta": {
            "label": "向下滚动探索",
            "href": "#exploded"
          }
        }
      },
      {
        "id": "exploded",
        "range": [0.14, 0.32],
        "content": {
          "eyebrow": "01 / STRUCTURE",
          "title": "结构，不只是轮廓。",
          "body": "拆解状态把十组装配语义同时展开：底部基准保持稳定，其余系统沿各自结构方向分离。",
          "cta": null
        }
      },
      {
        "id": "assembly",
        "range": [0.32, 0.78],
        "content": {
          "eyebrow": "02 / ASSEMBLY",
          "title": "从承载，到完整。",
          "body": "滚动依次收拢车轴、左右行走机构、功能核心、座舱、车身与开闭件。这是可解释的展示顺序，不是制造工艺说明。",
          "cta": null
        }
      },
      {
        "id": "reveal",
        "range": [0.78, 0.92],
        "content": {
          "eyebrow": "03 / REVEAL",
          "title": "所有系统，收束成产品。",
          "body": "部件回到经确认的基准变换后，镜头继续揭示完整外形；反向滚动时，拆解过程可确定性复现。",
          "cta": null
        }
      },
      {
        "id": "hero",
        "range": [0.92, 1],
        "content": {
          "eyebrow": "04 / PRODUCT",
          "title": "让产品自己证明它的结构。",
          "body": "一个压缩 GLB、一个语义清单和一个按需渲染循环，完成可复用的网页端产品叙事。",
          "cta": {
            "label": "查看结构清单",
            "href": "#architecture"
          }
        }
      }
    ],
