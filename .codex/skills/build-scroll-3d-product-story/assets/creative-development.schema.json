{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/creative-development.schema.json",
  "title": "Scroll 3D Creative Development",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "modelAudit",
    "research",
    "creativeRoutes",
    "selectedRouteId",
    "shots",
    "cameraPrevis",
    "animatic",
    "confirmation",
    "phaseHistory"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "planId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "modelAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelPath", "capability", "truths", "limitations", "prohibitedClaims"],
      "properties": {
        "modelPath": {"type": "string", "minLength": 1},
        "capability": {
          "enum": [
            "structured-named-parts",
            "separated-unnamed-parts",
            "partially-merged",
            "fused-single-mesh"
          ]
        },
        "truths": {"$ref": "#/$defs/nonEmptyStrings"},
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedClaims": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseStudies"],
      "properties": {
        "caseStudies": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/caseStudy"}
        }
      }
    },
    "creativeRoutes": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/creativeRoute"}
    },
    "selectedRouteId": {"type": "string", "minLength": 1},
    "shots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/shot"}
    },
    "cameraPrevis": {"$ref": "#/$defs/cameraPrevis"},
    "animatic": {"$ref": "#/$defs/animatic"},
    "confirmation": {"$ref": "#/$defs/confirmation"},
    "phaseHistory": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "body", "cta"],
      "properties": {
        "eyebrow": {"type": "string"},
        "title": {"type": "string"},
        "body": {"type": "string"},
        "cta": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": {"type": "string", "minLength": 1},
                "href": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "caseStudy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sourceUrl", "narrativeThesis", "transferableMethods", "limitations"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "format": "uri"},
        "narrativeThesis": {"type": "string", "minLength": 1},
        "transferableMethods": {"$ref": "#/$defs/nonEmptyStrings"},
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "creativeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "thesis", "audienceTakeaway", "shotArc", "modelFit", "risks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "thesis": {"type": "string", "minLength": 1},
        "audienceTakeaway": {"type": "string", "minLength": 1},
        "shotArc": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "modelFit": {"type": "string", "minLength": 1},
        "risks": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "range",
        "narrativePurpose",
        "viewerTakeaway",
        "startState",
        "endState",
        "action",
        "activeComponents",
        "camera",
        "lighting",
        "layout",
        "transitionIn",
        "transitionOut",
        "rhythm",
        "hold",
        "content",
        "truthConstraints"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "order": {"type": "integer", "minimum": 1, "maximum": 5},
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "narrativePurpose": {"type": "string", "minLength": 1},
        "viewerTakeaway": {"type": "string", "minLength": 1},
        "startState": {"type": "string", "minLength": 1},
        "endState": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "activeComponents": {"$ref": "#/$defs/nonEmptyStrings"},
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framing", "movement"],
          "properties": {
            "framing": {"type": "string", "minLength": 1},
            "movement": {"type": "string", "minLength": 1}
          }
        },
        "lighting": {"type": "string", "minLength": 1},
        "layout": {"type": "string", "minLength": 1},
        "transitionIn": {"type": "string", "minLength": 1},
        "transitionOut": {"type": "string", "minLength": 1},
        "rhythm": {"type": "string", "minLength": 1},
        "hold": {"type": "string", "minLength": 1},
        "content": {"$ref": "#/$defs/content"},
        "truthConstraints": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "animatic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "kind", "durationSeconds", "reviewed", "reviewNotes"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "kind": {"const": "animatic-video"},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "reviewed": {"const": true},
        "reviewNotes": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "cameraPrevis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "fps",
        "totalFrames",
        "frameStateCount",
        "continuityPath",
        "hiddenCut",
        "maxAbsRollDegrees",
        "stableHeroHold",
        "reviewed"
      ],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "fps": {"type": "integer", "minimum": 1},
        "totalFrames": {"type": "integer", "minimum": 1},
        "frameStateCount": {"type": "integer", "minimum": 1},
        "continuityPath": {"$ref": "#/$defs/nonEmptyStrings"},
        "hiddenCut": {"type": "string", "minLength": 1},
        "maxAbsRollDegrees": {"type": "number", "minimum": 0, "maximum": 12},
        "stableHeroHold": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 0}
        },
        "reviewed": {"const": true}
      }
    },
    "confirmation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"const": "pending"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvalId", "releasedAt", "evidenceRef", "checks"],
          "properties": {
            "status": {"const": "automated"},
            "approvalId": {"type": "string", "minLength": 1},
            "releasedAt": {"type": "string", "format": "date-time"},
            "evidenceRef": {"type": "string", "minLength": 1},
            "checks": {"$ref": "#/$defs/nonEmptyStrings"}
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "completedAt"],
      "properties": {
        "phase": {
          "enum": [
            "case-research",
            "creative-routes",
            "five-shot-script",
            "animatic",
            "automatic-release"
          ]
        },
        "completedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
